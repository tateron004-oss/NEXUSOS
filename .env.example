PORT=4288
HOST=0.0.0.0
NODE_ENV=production
AUTH_REQUIRED=true
NEXUSOS_REQUIRE_LIVE_SERVICES=false
NEXUSOS_ADMIN_EMAIL=admin@nexusos.local
NEXUSOS_ADMIN_PASSWORD=change-this-before-hosting
NEXUSOS_WORKSPACE_DIR=/app/workspace
NEXUSOS_DATA_DIR=/app/data

# Hosted production database.
DATABASE_URL=postgresql://user:password@host:5432/nexusos

# Optional live AI provider.
# When this is unset, NexusOS runs in local simulated assistant mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_PLANNER_MODEL=gpt-4o-mini

# Optional phone/SMS provider.
# When these are unset, NexusOS creates phone assistant workflow packages only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional billing provider.
# When unset, NexusOS uses demo subscription mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional email provider / SMTP adapter settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=hello@nexusos.local
